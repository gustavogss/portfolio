rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return true;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validation Helpers ---
    function isValidUsage(data) {
      return data.keys().hasAll(['userId', 'generationsCount']) &&
             data.keys().size() >= 2 &&
             data.userId == request.auth.uid &&
             data.generationsCount is int &&
             data.generationsCount >= 0;
    }

    // --- Collection Routes ---
    
    // Usage limits
    match /usage/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && 
                       isValidUsage(incoming()) && 
                       incoming().generationsCount == 1;
      allow update: if isOwner(userId) && 
                       isValidUsage(incoming()) &&
                       incoming().userId == existing().userId &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['generationsCount', 'lastGenerationAt'])
                       );
    }

    // Projects
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(projectId);
    }

    // Posts (Blog)
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(postId);
    }

    // Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(courseId);
    }

    // Skills
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(skillId);
    }

    // Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingsId);
    }

    // Experiences
    match /experiences/{expId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(expId);
    }

    // Education
    match /education/{eduId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(eduId);
    }

    // Certifications
    match /certifications/{certId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(certId);
    }

    // Notifications (CMS system warnings, metrics, etc.)
    match /notifications/{notifId} {
      allow read, write: if isAdmin() && isValidId(notifId);
    }

    // Error Logs
    match /error_logs/{logId} {
      allow read, write: if true;
    }
  }
}
